# Hobbit-NG example environment variables
# Copy to your deployment secret/environment system; do not commit real secrets.

JWT_SECRET=replace-with-a-long-random-secret
REDIS_URL=redis://localhost:6379/0
HOBBIT_CORS_ORIGINS=http://localhost:3000

# Optional public Stripe-hosted Payment Link. Leave blank to disable donation prompts.
# Example live format: https://donate.stripe.com/<your-live-link>
HOBBIT_DONATION_URL=
